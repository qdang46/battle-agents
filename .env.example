# Copy to .env and fill in. Never commit .env.
# Every key below is read by the server; see the drizzle/docker beads for local wiring.

# ── Want to look at the product without registering a GitHub OAuth app? ────────
# Set this to 1 and run `pnpm dev`. Every page behind the sign-in gate renders,
# labelled DEV LOGIN in the top bar, so nobody mistakes it for a real session.
#
# It mints nothing: no cookie, no session row, no user. It only decides who the
# reader is, and it is REFUSED whenever NODE_ENV=production -- which includes
# `next start` and every real deployment. Leave it unset in .env.example itself.
AGENT_BATTLE_DEV_LOGIN=

# Secret used to sign session cookies. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Origin the auth server binds to. Local dev runs on the Next.js port.
BETTER_AUTH_URL=http://127.0.0.1:3000

# OAuth app credentials from https://github.com/settings/developers.
# REGISTER A DEVELOPMENT APP with EXACTLY these two values, or GitHub rejects the
# login with redirect_uri_mismatch -- the most likely first-run failure.
#   Homepage URL:               http://127.0.0.1:3000
#   Authorization callback URL: http://127.0.0.1:3000/api/auth/callback/github
# Use 127.0.0.1, NOT localhost: GitHub treats them as different origins.
# Register a SEPARATE app for production so local testing cannot invalidate the
# deployed callback configuration.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Full callback URL, written out so nobody has to reconstruct it. Better Auth
# owns the /api/auth/[...all] mount; the GitHub provider callback lands at
# /api/auth/callback/github. Never put a token in this URL.
GITHUB_CALLBACK_URL=http://127.0.0.1:3000/api/auth/callback/github

# ── The GitHub INTEGRATION (ba-github-infrastructure-56v) ─────────────────────
# Two server-side secrets, both read only by packages/infrastructure/github.
# Neither is ever returned in a response, logged, put in a URL, or written to the
# database — that is a property of the shapes, not of discipline: there is no
# exported type in the package capable of holding either one.
#
# GITHUB_WEBHOOK_SECRET signs deliveries to POST /api/webhooks/github. Set it
# with `openssl rand -base64 32` and give the same value to GitHub when you
# create the webhook. With it unset the endpoint answers 401 to everything,
# which is deliberate: an endpoint that cannot tell an authentic delivery from
# a forged one must not accept either.
GITHUB_WEBHOOK_SECRET=

# The App installation token used for the one outbound call (does this issue
# exist). It is a SEPARATE secret from the OAuth client secret above and from
# the webhook secret: the OAuth pair authenticates a human, this authenticates
# our server to GitHub, and the webhook secret authenticates GitHub to us.
# Unset means issue validation reports "unconfigured", which is NOT the same as
# "the issue does not exist" — the two are kept apart so a missing variable
# cannot look like a wave of refused bounties.
GITHUB_APP_TOKEN=

# Postgres connection string. Hosted Neon in production, the Docker Compose
# Postgres locally. Owned by ba-db-schema-drizzle-fki and ba-docker-local-dev-y28.
DATABASE_URL=

# Host ports for the local stack.
#
# These exist because the defaults collide. 5432 and 5433 are the first ports
# anybody reaches for, so a machine already running another project's database
# owns them, and the symptom is not an obvious "port in use": Compose starts
# this project's container, the container reports itself healthy, and the host
# port keeps answering for the other server. The pipeline then fails on a
# password error against a database this project never started.
#
# If `pnpm test:m0` reports that no container publishes the port, something else
# on the machine has it. Pick anything free; the values only have to agree with
# each other and with DATABASE_URL when you set that explicitly. Left commented
# so a freshly copied .env overrides nothing.
# WEB_PORT=3000               # the local dev web server
# POSTGRES_PORT=5432          # the local dev database
# M0_PG_PUBLISHED_PORT=5443   # the throwaway test database used by test:m0
