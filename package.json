{
  "name": "battle-agents",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "architecture": "tsx scripts/check-architecture.ts",
    "build": "tsc -b tsconfig.build.json",
    "check:moltbook": "bash scripts/check-moltbook-claims.sh",
    "codegen": "tsx scripts/generate-action-ids.ts",
    "codegen:check": "bash scripts/check-codegen-fresh.sh",
    "db:generate": "drizzle-kit generate --config=packages/db/drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config=packages/db/drizzle.config.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:verify": "tsx packages/db/src/verify.ts",
    "format": "prettier --write .",
    "license-check": "bash scripts/check-licenses.sh",
    "load:events": "tsx scripts/load-test-events.ts",
    "lint": "prettier --check .",
    "removal-test": "bash scripts/removal-test.sh",
    "schema-hygiene": "bash scripts/check-schema-hygiene.sh",
    "test": "pnpm run test:unit",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:m0": "bash scripts/test-m0.sh",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "typecheck": "tsc -b tsconfig.build.json && tsc -p tsconfig.json",
    "check:docs": "bash scripts/check-docs.sh",
    "check:pooled-driver": "bash scripts/check-pooled-driver.sh",
    "check:adapter-boundary": "bash scripts/check-adapter-boundary.sh",
    "check:watchlist": "bash scripts/check-watchlist-claims.sh",
    "check:assets": "bash scripts/check-assets.sh"
  },
  "devDependencies": {
    "@battle-agents/activity": "workspace:*",
    "@battle-agents/agent": "workspace:*",
    "@battle-agents/api": "workspace:*",
    "@battle-agents/core": "workspace:*",
    "@battle-agents/db": "workspace:*",
    "@battle-agents/protocol": "workspace:*",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.3",
    "pg": "^8.23.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^6.0.0",
    "vitest": "^5.0.1"
  }
}
