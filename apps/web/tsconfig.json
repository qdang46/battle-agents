{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // No rootDir and no outDir on purpose. This app is BUILT by `next build`;
    // tsc here is the type gate only. Keeping the library rootDir would make
    // every file under app/ an error, and the app directory is where a Next.js
    // app's source lives.
    "noEmit": true,
    "jsx": "preserve",
    // The DOM library, and it is here because the base config deliberately does
    // not carry it: a LIBRARY package must not acquire browser globals it never
    // runs against. This app is not a library — it is a browser application, and
    // a client component that appends a canvas to a div is the ordinary case for
    // it. Without this, `HTMLDivElement` resolves (React's types bring it) while
    // `appendChild` does not, which is a confusing half-error rather than a
    // clear one.
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "allowJs": true,
    "paths": {
      "@/*": ["./src/*"]
    },
    "types": ["node", "react"],
    "incremental": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "app/**/*.ts",
    "app/**/*.tsx",
    "next.config.mjs",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
